# Copy to .env.local

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://factura:factura@localhost:5433/factura

# ── Auth (NextAuth v5 / Auth.js) ────────────────────────────────────────────
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=factura.app
# Google OAuth credentials (console.cloud.google.com → Credentials → OAuth client).
# Authorized redirect URI: http://localhost:4000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed if the app isn't served from its own origin (e.g. behind a proxy).
# AUTH_URL=http://localhost:4000
# Canonical public origins used by browser links and server-side allowlists.
NEXT_PUBLIC_SITE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4001
# Production only: share the Auth.js session with app.factura.uno.
# SESSION_COOKIE_DOMAIN=.factura.uno

# ── Transactional email (Resend) ────────────────────────────────────────────
# Powers email one-time-password sign-in plus the welcome message.
# Leave RESEND_API_KEY blank in local dev: sign-in codes are logged to the
# server console instead of emailed, so you can still log in without Resend.
RESEND_API_KEY=
# Verified sender, e.g. "Factura <hello@yourdomain.com>".
EMAIL_FROM=

# ── Notifications → Telegram ────────────────────────────────────────────────
# Where /contacto sends what visitors write and optional sign-up notices.
# Create a bot with @BotFather, add it to the channel as an admin, and put the
# channel's numeric id below (the -100… form). Leave blank in local dev: messages
# are logged to the server console instead, and the form still answers as if it
# had been delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# The same channel gets a line when somebody creates an account. Returning
# sign-ins stay quiet by default:
#   new (or unset) — only accounts being created
#   all             — every sign-in (explicit opt-in)
#   off             — nothing
TELEGRAM_NOTIFY_SIGNINS=new

# ── S3-compatible storage for public CMS media ──────────────────────────────
# CMS images use their own publicly readable bucket. The generic connection
# values may still be shared with the app deployment's S3/R2 account, but this
# marketing repository never reads or writes the private bill-PDF bucket.
CMS_MEDIA_S3_BUCKET=factura-cms-media
CMS_MEDIA_PUBLIC_ORIGIN=http://localhost:9000/factura-cms-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=factura
S3_SECRET_ACCESS_KEY=facturasecret
# true for MinIO and most non-AWS providers; false (or unset) for AWS S3.
S3_FORCE_PATH_STYLE=true
