{
  "name": "factura",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "dev": "next dev -p 4000",
    "email": "email dev --dir emails --port 3001",
    "build": "next build",
    "test": "vitest run",
    "test:db": "dotenv -e .env.local -- vitest run",
    "indexnow": "bun scripts/ping-indexnow.ts",
    "media:sweep": "dotenv -e .env.prod -- bun --preload ./scripts/lib/serverOnlyShim.ts scripts/mediaSweep.ts",
    "content:locations:seed": "dotenv -e .env.local -- bun --preload ./scripts/lib/serverOnlyShim.ts scripts/seed-content-locations.ts",
    "content:locations:backfill": "dotenv -e .env.local -- bun --preload ./scripts/lib/serverOnlyShim.ts scripts/backfill-content-locations.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "audit:seo": "bun scripts/audit-seo.ts",
    "preview:guide": "bun scripts/build-guide-preview.ts",
    "data:caba": "bun scripts/fetch-caba-inmobiliario.ts",
    "data:pba": "bun scripts/fetch-pba-inmobiliario.ts",
    "data:suelo": "bun scripts/fetch-pba-suelo.ts",
    "data:construccion": "bun scripts/fetch-caba-construccion.ts",
    "data:delitos": "bun scripts/fetch-caba-delitos.ts",
    "data:escrituras": "bun scripts/fetch-pba-escrituras.ts",
    "data:dolar": "bun scripts/fetch-dolar.ts",
    "data:caba-geo": "bun scripts/build-caba-geo.ts",
    "data:pba-geo": "bun scripts/build-pba-geo.ts",
    "db:push": "dotenv -e .env.local drizzle-kit push",
    "db:push:prod": "dotenv -e .env.prod drizzle-kit push",
    "db:studio": "dotenv -e .env.local drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@react-email/components": "^1.0.12",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.34.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-serverless": "^1.3.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.416.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.19.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.9",
    "react-email": "^6.9.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
