{
  "name": "factura",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "dev": "next dev -p 4000",
    "email": "email dev --dir emails --port 3001",
    "build": "next build",
    "test": "vitest run",
    "test:db": "dotenv -e .env.local -- vitest run",
    "predev": "npm run build:worker",
    "prebuild": "npm run build:worker",
    "indexnow": "bun scripts/ping-indexnow.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build:worker": "node scripts/build-suggest-worker.mjs",
    "validate:content": "bun scripts/validate-content.ts",
    "content:import:guides": "bun scripts/import-guides.ts",
    "content:import:sections": "bun scripts/import-sections.ts",
    "validate:guides": "bun scripts/validate-guides.ts",
    "validate:sections": "bun scripts/validate-sections.ts",
    "validate:stats": "bun scripts/validate-stats.ts",
    "validate:investigacion": "bun scripts/validate-investigacion.ts",
    "audit:seo": "bun scripts/audit-seo.ts",
    "data:caba": "bun scripts/fetch-caba-inmobiliario.ts",
    "data:pba": "bun scripts/fetch-pba-inmobiliario.ts",
    "data:suelo": "bun scripts/fetch-pba-suelo.ts",
    "data:construccion": "bun scripts/fetch-caba-construccion.ts",
    "data:delitos": "bun scripts/fetch-caba-delitos.ts",
    "data:dolar": "bun scripts/fetch-dolar.ts",
    "data:caba-geo": "bun scripts/build-caba-geo.ts",
    "data:pba-geo": "bun scripts/build-pba-geo.ts",
    "db:push": "dotenv -e .env.local drizzle-kit push",
    "db:push:prod": "dotenv -e .env.prod drizzle-kit push",
    "db:seed": "dotenv -e .env.local tsx src/db/seed.ts",
    "db:seed:prod": "dotenv -e .env.prod tsx src/db/seed.ts",
    "db:studio": "dotenv -e .env.local drizzle-kit studio",
    "parser:official": "dotenv -e .env.local -- tsx scripts/makeParserOfficial.ts",
    "parser:official:prod": "dotenv -e .env.prod -- tsx scripts/makeParserOfficial.ts",
    "parser:update": "dotenv -e .env.local -- tsx scripts/updateOfficialParser.ts",
    "parser:update:prod": "dotenv -e .env.prod -- tsx scripts/updateOfficialParser.ts",
    "sample:pdf": "tsx scripts/makeSamplePdf.ts",
    "submissions:cleanup:prod": "dotenv -e .env.prod -- tsx scripts/cleanupSubmissionFiles.ts",
    "submissions:pull:prod": "dotenv -e .env.prod -- tsx scripts/pullUnrecognizedSubmissions.ts",
    "forecast:backtest": "dotenv -e .env.local -- tsx scripts/backtestForecast.ts",
    "forecast:backtest:prod": "dotenv -e .env.prod -- tsx scripts/backtestForecast.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/mdx": "^2.0.14",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-serverless": "^1.3.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.416.0",
    "posthog-node": "^5.48.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "recheck": "^4.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.9",
    "react-email": "^6.9.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
